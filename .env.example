APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TAHOMA_HOST=192.168.1.42
TAHOMA_PORT=8443
TAHOMA_TOKEN=
TAHOMA_DEVICE_URL=
TAHOMA_VERIFY_SSL=false

AWNING_LATITUDE=
AWNING_LONGITUDE=
AWNING_TIMEZONE=UTC
AWNING_FACADE_TILT=90
AWNING_FACADE_AZIMUTH=45
AWNING_FLOOR=1
AWNING_METRES_PER_FLOOR=3
AWNING_SITE_EXPOSURE_FACTOR=1.0
AWNING_GLASS_AREA_M2=7.2
AWNING_SHGC=0.55
AWNING_OPEN_TEMPERATURE_C=19
AWNING_CLOSE_TEMPERATURE_C=16.5
AWNING_OPEN_HEAT_GAIN_W=900
AWNING_CLOSE_HEAT_GAIN_W=500
AWNING_MAX_WIND_SPEED_KMH=28
AWNING_MAX_WIND_GUST_KMH=42
AWNING_SQUALL_GUST_KMH=55
AWNING_CLEAR_WIND_SPEED_KMH=22
AWNING_CLEAR_WIND_GUST_KMH=34
AWNING_MAX_PRECIPITATION_MM=0.4
AWNING_FORECAST_LOOKAHEAD_MINUTES=60
AWNING_WIND_LOOKAHEAD_MINUTES=20
AWNING_PRECIPITATION_LOOKAHEAD_MINUTES=30
AWNING_MIN_STATE_CHANGE_MINUTES=45
AWNING_WIND_RECOVERY_MINUTES=15
AWNING_WEATHER_CACHE_SECONDS=600
